# =============================================================================
# Variables del frontend (desarrollo local con Vite)
# Copiar a .env.local para: npm run dev
# =============================================================================
# En dev, Vite corre en :3000 y la API en :8080 (requiere CORS en el backend)
VITE_API_URL=http://localhost:8080/api
VITE_USE_MOCK=false

# =============================================================================
# Producción / Docker
# El frontend se compila embebido en Spring Boot con VITE_API_URL=/api (ruta relativa).
# No hace falta configurar VITE_* en el .env de la raíz del repositorio.
# =============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

.minikube/
*.kubeconfig
kubeconfig
.kube/config.backup

# Helm: dependencias descargadas (Chart.yaml y values sí van al repo)
charts/**/charts/
*.tgz

# Renderizados locales con secretos inyectados
**/rendered/
**/kustomize/**/secrets/
.overlays/local/

# -----------------------------------------------------------------------------
# Bases de datos — volúmenes y dumps (scripts SQL/JSON de seed SÍ van al repo)
# -----------------------------------------------------------------------------

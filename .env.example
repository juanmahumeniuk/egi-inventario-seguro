# =============================================================================
# Despliegue con Docker (docker-compose.yml)
# Copiar a .env y ajustar valores antes de: docker compose up --build -d
# =============================================================================

# --- SQL Server (VM externa, NO dockerizada) ---
DB_URL=jdbc:sqlserver://sqlserver.itu.local:1433;databaseName=inventario_egi;encrypt=true;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=

# --- MongoDB (contenedor en la misma red Docker) ---
MONGO_URI=mongodb://mongodb:27017/inventario_egi

# --- CORS (solo necesario para desarrollo con Vite en :3000) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Nota: el frontend se embebe en Spring Boot durante el build (VITE_API_URL=/api).
# Las variables VITE_* solo aplican en desarrollo local con npm run dev;
# ver app/inventario-web/frontend/.env.example

# =============================================================================
# Desarrollo local: SQL Server en Docker (docker-compose.dev.yml)
# Descomentar y usar junto con: docker compose -f docker-compose.dev.yml up -d
# =============================================================================
# DB_URL=jdbc:sqlserver://host.docker.internal:1433;databaseName=inventario_egi;encrypt=false;trustServerCertificate=true
# DB_PASSWORD=EGI_Password123!
